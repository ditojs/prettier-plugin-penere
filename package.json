{
  "name": "prettier-plugin-penere",
  "version": "0.4.0",
  "description": "Prettier that respects your line breaks: expressive, controllable formatting on top of stock Prettier",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "penere",
    "formatter"
  ],
  "license": "MIT",
  "author": "Jürg Lehni <juerg@scratchdisk.com>",
  "repository": "ditojs/prettier-plugin-penere",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "format": "prettier --write src tests/*.js playground/*.js",
    "format:check": "prettier --check src tests/*.js playground/*.js",
    "playground": "vite --config playground/vite.config.js",
    "playground:build": "vite build --config playground/vite.config.js"
  },
  "peerDependencies": {
    "prettier": "~3.9.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "lz-string": "^1.5.0",
    "prettier": "3.9.9",
    "vite": "^8.3.2"
  }
}
